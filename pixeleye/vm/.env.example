# Pixeleye VM deployment — copy to .env, fill in, chmod 600.
# NEVER commit .env. Generate secrets ON THE VM so they never touch a shell
# history or a copied file:
#
#   openssl rand -base64 32 | tr -d '/+=' | head -c 32
#
# PIXELEYE_HOST_BASE is the reserved static external IP with .sslip.io appended.
# sslip.io resolves <anything>.<IP>.sslip.io to <IP>, giving four public
# hostnames with no DNS administration. Must match the IP actually assigned to
# this VM, or Let's Encrypt validation fails.
PIXELEYE_HOST_BASE=CHANGEME.sslip.io

# Contact address Let's Encrypt uses for expiry warnings.
ACME_EMAIL=julien.schneider@dasch.swiss

# Postgres
DB_USERNAME=guest
DB_PASSWORD=CHANGEME

# RabbitMQ
AMQP_USER=pixeleye
AMQP_PASSWORD=CHANGEME

# MinIO root — used ONLY by the minio service and minio-init. Pixeleye itself
# gets the scoped service account below.
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=CHANGEME

# Scoped MinIO service account for pixeleye, limited to the pixeleye bucket by
# minio-policy.json.
S3_ACCESS_KEY_ID=pixeleye-app
S3_KEY_SECRET=CHANGEME

# Ory Kratos. CIPHER must be EXACTLY 32 characters.
KRATOS_COOKIE_SECRET=CHANGEME
KRATOS_CIPHER_SECRET=CHANGEME-EXACTLY-32-CHARS-LONG..
