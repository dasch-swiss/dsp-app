load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@rules_sass//src:index.bzl", "npm_sass_library", "sass_library")

# The shared Sass partials; a stylesheet that does `@use 'config'`, `'mixins'` or `'responsive'`
# lists this in its library's `sass_deps`.
sass_library(
    name = "styles",
    srcs = [
        "_config.scss",
        "_mixins.scss",
        "_responsive.scss",
    ],
    visibility = ["//visibility:public"],
)

# Angular Material's Sass and the CDK's it loads, for a stylesheet that does `@use '@angular/material'`.
npm_sass_library(
    name = "material",
    visibility = ["//visibility:public"],
    deps = [
        "//:node_modules/@angular/cdk",
        "//:node_modules/@angular/material",
    ],
)

# The partials as plain files, for the Storybook build's webpack Sass (angular.json's
# `stylePreprocessorOptions`).
js_library(
    name = "storybook_sources",
    srcs = glob(["_*.scss"]),
    visibility = ["//:__pkg__"],
)
