{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../dist/out-tsc",
    "declaration": true,
    "declarationMap": true,
    "inlineSources": true,
    "types": ["window", "ckeditor5-custom-build"]
  },
  "exclude": [
    "src/**/*.spec.ts",
    "src/test-setup.ts",
    "jest.config.js",
    "src/**/*.test.ts",
    "**/*.stories.ts",
    "**/stories.helpers.ts",
    "**/*.stories.helpers.ts",
    "**/*-stories.helper.ts"
  ],
  "include": ["src/**/*.ts"]
}
