{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "outDir": "../../../../dist/out-tsc",
    "declaration": true,
    "types": ["node", "window", "ckeditor5-custom-build"]
  },
  "include": ["src/**/*.ts"],
  "exclude": [
    "jest.config.js",
    "src/**/*.spec.ts",
    "src/**/*.test.ts",
    "**/*.stories.ts",
    "**/stories.helpers.ts",
    "**/*.stories.helpers.ts",
    "**/*-stories.helper.ts"
  ]
}
