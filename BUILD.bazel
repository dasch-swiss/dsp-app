load("@aspect_rules_js//js:defs.bzl", "js_library")
load("@aspect_rules_ts//ts:defs.bzl", "ts_config")
load("@npm//:defs.bzl", "npm_link_all_packages")

package(default_visibility = ["//visibility:public"])

npm_link_all_packages(name = "node_modules")

exports_files([
    "package.json",
    "pnpm-lock.yaml",
])

ts_config(
    name = "tsconfig_base",
    src = "tsconfig.base.json",
)

# The declarations the libraries' `types` name, found through tsconfig.base.json's typeRoots.
js_library(
    name = "ambient_types",
    srcs = glob(["types/*.d.ts"]),
)

# The shared Jest preset and what it reads; every vre_jest_test depends on it.
js_library(
    name = "jest_preset",
    srcs = [
        "jest.preset.js",
        "jest.resolver.js",
        "tsconfig.base.json",
    ],
)

# The flat ESLint config and what it loads, for the lint aspect. `prettier/prettier` reads
# .prettierrc; without it the rule reports every quote in every file.
js_library(
    name = "eslintrc",
    srcs = [
        ".prettierrc",
        "eslint.config.angular.mjs",
        "eslint.config.mjs",
    ],
    deps = [
        ":node_modules/@eslint/js",
        ":node_modules/@typescript-eslint/parser",
        ":node_modules/angular-eslint",
        ":node_modules/eslint-config-prettier",
        ":node_modules/eslint-plugin-ban",
        ":node_modules/eslint-plugin-import",
        ":node_modules/eslint-plugin-prettier",
        ":node_modules/eslint-plugin-storybook",
        ":node_modules/eslint-plugin-unused-imports",
        ":node_modules/globals",
        ":node_modules/prettier",
        ":node_modules/typescript-eslint",
    ],
)
