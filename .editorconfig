# Editor configuration, see https://editorconfig.org
# Indentation follows .prettierrc, which formats the code; keep the two in agreement.
root = true

[*]
charset = utf-8
indent_style = space
indent_size = 2
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
max_line_length = off
trim_trailing_whitespace = false

[nginx/**]
indent_size = 4
