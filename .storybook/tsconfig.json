{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "emitDecoratorMetadata": true,
    "lib": ["ES2021", "dom", "dom.iterable"],
    "module": "preserve",
    "moduleResolution": "bundler"
  },
  "exclude": ["../**/*.spec.ts"],
  "include": [
    "../libs/**/*.stories.ts",
    "../libs/**/stories.helpers.ts",
    "../libs/**/*.stories.helpers.ts",
    "../libs/**/*-stories.helper.ts",
    "../apps/**/*.stories.ts",
    "../apps/dsp-app/src/polyfills.ts",
    "../types/*.d.ts",
    "*.js",
    "*.ts"
  ]
}
